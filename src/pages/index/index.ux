</style>

<script>
import link from '../../common/scripts/interconnect'
import audio from '@system.audio'

export default {
  private: {
    connected: false,
    connectionLabel: 'Not connected',
    videoTitle: 'No video selected',
    videoSubtitle: 'Open YouTube Mini on your phone',
    selectedVideoId: '',
    selectedThumbnailUrl: '',
    thumbnailFailed: true,
    thumbnailMessage: 'Choose a video on your phone to load its cover.',
    audioSource: '',
    audioStatus: 'Waiting for an audio link from your phone.',
    commentsText: 'Tap VIEW COMMENTS to load comments.',
    selectedLikeCount: '—',
    selectedCommentCount: '—',
    searchHint: 'Search on your phone, then send a video here.',
  },
  onInit() {
    audio.autoplay = false
    audio.loop = false
    audio.onplay = () => { this.audioStatus = 'PLAYING' }
    audio.onpause = () => { this.audioStatus = 'PAUSED' }
    audio.onstop = () => { this.audioStatus = 'STOPPED' }
    audio.onloadeddata = () => { this.audioStatus = 'READY TO PLAY' }
    audio.onended = () => { this.audioStatus = 'PLAYBACK FINISHED' }
    audio.onerror = () => { this.audioStatus = 'PLAYBACK ERROR. CHECK THE AUDIO URL.' }
    this.unsubscribeLink = link.subscribe((event) => {
      if (event.message && event.message.type === 'video.select') {
        const payload = event.message.payload || {}
        this.videoTitle = payload.title || 'Video selected'
        this.videoSubtitle = payload.channelTitle || 'Sent from phone'
        this.selectedVideoId = payload.videoId || ''
        this.selectedThumbnailUrl = payload.thumbnailUrl || ''
        this.thumbnailFailed = !this.selectedThumbnailUrl
        this.thumbnailMessage = this.selectedThumbnailUrl ? 'Loading cover...' : 'No cover URL was sent.'
        this.selectedLikeCount = payload.likeCount || '—'
        this.selectedCommentCount = payload.commentCount || '—'
      }
      if (event.message && event.message.type === 'audio.source') {
        const payload = event.message.payload || {}
        const source = payload.src || ''
        if (source.indexOf('https://') !== 0 && source.indexOf('http://') !== 0) {
          this.audioStatus = 'Invalid audio URL. Send a direct HTTP(S) audio link.'
        } else {
          try {
            audio.pause()
            audio.src = source
            audio.meta = { title: payload.title || 'YouTube Mini audio', artist: 'YouTube Mini', album: 'Audio' }
            audio.autoplay = false
            this.audioSource = source
            this.audioStatus = 'AUDIO READY. PRESS PLAY.'
          } catch (error) {
            this.audioStatus = 'Could not load audio source.'
          }
        }
      }
      if (event.message && event.message.type === 'comments.items') {
        const payload = event.message.payload || {}
        const items = Array.isArray(payload.items) ? payload.items : []
        this.commentsText = payload.error || (items.length
          ? items.map((item, index) => (index + 1) + '. ' + item.author + ': ' + item.text).join('\n\n')
          : 'No public comments found. Comments may be disabled.')
      }
      if (event.message && event.message.type === 'video.search.error') {
        const payload = event.message.payload || {}
        this.searchHint = payload.message || 'Search failed'
      }
      if (event.state) {
        this.connected = event.state === 'connected'
        this.connectionLabel = this.connected ? 'Phone connected' : 'Not connected'
      }
    })
    link.checkConnection()
  },
  onDestroy() {
    if (this.unsubscribeLink) this.unsubscribeLink()
    audio.onplay = null
    audio.onpause = null
    audio.onstop = null
    audio.onloadeddata = null
    audio.onended = null
    audio.onerror = null
  },
  retryConnection() {
    link.checkConnection()
  },
  selectVideo(videoId, title, channelTitle, thumbnailUrl, likeCount, commentCount) {
    const payload = { videoId, title, channelTitle, thumbnailUrl }
    if (!link.send('video.select', payload)) {
      this.searchHint = 'Not connected'
      return
    }
    this.videoTitle = title || 'Video selected'
    this.videoSubtitle = channelTitle || 'Selected on watch'
    this.selectedVideoId = videoId || ''
    this.selectedThumbnailUrl = thumbnailUrl || ''
    this.thumbnailFailed = !this.selectedThumbnailUrl
    this.thumbnailMessage = this.selectedThumbnailUrl ? 'Loading cover...' : 'No cover URL was provided.'
    this.selectedLikeCount = likeCount || '—'
    this.selectedCommentCount = commentCount || '—'
    this.searchHint = 'Video sent to phone app.'
  },
  thumbnailLoaded() {
    this.thumbnailFailed = false
    this.thumbnailMessage = 'Cover loaded.'
  },
  thumbnailError() {
    this.thumbnailFailed = true
    this.thumbnailMessage = 'Cover could not load. Check watch internet access.'
    this.searchHint = 'The video cover could not be downloaded.'
  },
  playAudio() {
    if (!this.audioSource) {
      this.audioStatus = 'Send a direct audio URL from the phone app first.'
      return
    }
    try {
      audio.play()
      this.audioStatus = 'STARTING AUDIO...'
    } catch (error) {
      this.audioStatus = 'PLAY FAILED. CHECK THE AUDIO URL.'
    }
  },
  pauseAudio() {
    if (!this.audioSource) {
      this.audioStatus = 'No audio source received yet.'
      return
    }
    try { audio.pause() } catch (error) { this.audioStatus = 'PAUSE FAILED.' }
  },
  stopAudio() {
    if (!this.audioSource) {
      this.audioStatus = 'No audio source received yet.'
      return
    }
    try { audio.stop() } catch (error) { this.audioStatus = 'STOP FAILED.' }
  },
  loadComments() {
    if (!this.selectedVideoId) {
      this.commentsText = 'Select a video first.'
      return
    }
    if (!link.send('comments.load', { videoId: this.selectedVideoId })) {
      this.commentsText = 'Phone is not connected.'
    } else {
      this.commentsText = 'Loading public comments...'
    }
  },
  openVideoOnPhone() {
    if (!this.selectedVideoId) {
      this.searchHint = 'Select a video first.'
      return
    }
    if (!link.send('video.open', { videoId: this.selectedVideoId })) {
      this.searchHint = 'Phone is not connected.'
    } else {
      this.searchHint = 'Opening video on phone...'
    }
  },
}
</script>