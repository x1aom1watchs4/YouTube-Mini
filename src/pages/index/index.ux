<template>
  <scroll class="page" scroll-y="true">
    <div class="top">
      <text class="brand">YouTube Mini</text>
      <text class="version">0.1 • WATCH</text>
    </div>

    <div class="connection">
      <div class="status-dot {{connected ? 'online' : 'offline'}}"></div>
      <text class="status">{{connectionLabel}}</text>
    </div>

    <div class="search-panel">
      <text class="video-label">ВЫБОР ВИДЕО</text>
      <text class="search-hint">Найди ролик в приложении на телефоне и отправь его на часы. Здесь появятся обложка, лайки и комментарии.</text>
    </div>

    <div class="hero">
      <text class="eyebrow">ВАША МУЗЫКА И ВИДЕО</text>
      <text class="headline">Видео рядом.</text>
      <text class="sub">Выберите ролик на телефоне и отправьте его на часы.</text>
    </div>

    <div class="video-card">
      <text class="video-label">СЕЙЧАС ВЫБРАНО</text>
      <image if="{{selectedThumbnailUrl}}" class="selected-thumb" src="{{selectedThumbnailUrl}}" alt="blank" @error="thumbnailError" />
      <text class="video-title">{{videoTitle}}</text>
      <text class="video-sub">{{videoSubtitle}}</text>
      <text class="search-hint">{{searchHint}}</text>
      <text class="open-video" @click="openVideoOnPhone">ОТКРЫТЬ НА ТЕЛЕФОНЕ</text>
      <text class="selected-stats">♥ {{selectedLikeCount}} · Комментарии: {{selectedCommentCount}}</text>
      <text class="comments-button" @click="loadComments">КОММЕНТАРИИ</text>
      <text class="comments-text">{{commentsText}}</text>
    </div>

    <div class="bottom">
      <text class="retry" @click="retryConnection">ПРОВЕРИТЬ СВЯЗЬ</text>
      <text class="foot">Телефон ↔ часы</text>
    </div>
  </scroll>
</template>

