<template>
  <scroll class="page" scroll-y="true">
    <div class="top">
      <text class="brand">YouTube Mini</text>
      <text class="version">0.1 • WATCH</text>
    </div>

    <div class="connection">
      <div class="status-dot {{connected ? 'online' : 'offline'}}"></div>
      <text class="status">{{connectionLabel}}</text>
    </div>

    <div class="search-panel">
      <text class="video-label">ПОИСК НА ТЕЛЕФОНЕ</text>
      <text class="query-display">{{searchQuery || 'Набери запрос ниже'}}</text>
      <div class="keyboard-row">
        <text class="key" for="{{keyboardRow1}}" @click="appendSearch($item)">{{$item}}</text>
      </div>
      <div class="keyboard-row">
        <text class="key" for="{{keyboardRow2}}" @click="appendSearch($item)">{{$item}}</text>
      </div>
      <div class="keyboard-row">
        <text class="key" for="{{keyboardRow3}}" @click="appendSearch($item)">{{$item}}</text>
        <text class="key key-action" @click="deleteSearch">⌫</text>
      </div>
      <div class="keyboard-row">
        <text class="key key-action" @click="switchKeyboard">{{keyboardLanguage}}</text>
        <text class="key key-wide" @click="appendSearch(' ')">ПРОБЕЛ</text>
        <text class="key key-action" @click="clearSearch">×</text>
      </div>
      <input class="search-button" type="button" value="ИСКАТЬ" @click="searchOnPhone" />
      <text class="search-hint">{{searchHint}}</text>
      <div class="result" for="{{videoResults}}" tid="videoId" @click="selectVideo($item.videoId, $item.title, $item.channelTitle)">
        <text class="result-title">{{$item.title}}</text>
        <text class="result-channel">{{$item.channelTitle}}</text>
      </div>
    </div>

    <div class="hero">
      <text class="eyebrow">ВАША МУЗЫКА И ВИДЕО</text>
      <text class="headline">Видео рядом.</text>
      <text class="sub">Выберите ролик на телефоне и отправьте его на часы.</text>
    </div>

    <div class="video-card">
      <text class="video-label">СЕЙЧАС ВЫБРАНО</text>
      <text class="video-title">{{videoTitle}}</text>
      <text class="video-sub">{{videoSubtitle}}</text>
      <div class="controls">
        <text class="control" @click="sendPause">Ⅱ</text>
        <text class="control primary" @click="sendPlay">▶</text>
        <text class="control" @click="sendStop">■</text>
      </div>
      <text class="hint">{{playbackHint}}</text>
    </div>

    <div class="bottom">
      <text class="retry" @click="retryConnection">ПРОВЕРИТЬ СВЯЗЬ</text>
      <text class="foot">Телефон ↔ часы</text>
    </div>
  </scroll>
</template>

<style>
