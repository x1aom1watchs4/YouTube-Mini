  margin-top: 22px;
  height: 38px;
  border-radius: 20px;
  background-color: #171b24;
  flex-direction: row;
  align-items: center;
  padding-left: 14px;
}
.status-dot {
  width: 10px;
  height: 10px;
  border-radius: 5px;
  margin-right: 9px;
}
