  color: #717b8d;
  font-size: 12px;
  margin-top: 10px;
}
</style>

<script>
import link from '../../common/scripts/interconnect'

export default {
  private: {
    connected: false,
    connectionLabel: 'Нет соединения',
    videoTitle: 'Пока ничего не выбрано',
    videoSubtitle: 'Откройте YouTube Mini на телефоне',
    playbackHint: 'Плеер часов пока проверяется',
    searchQuery: '',
    searchHint: 'Поиск выполняется на телефоне',
    videoResults: [],
    keyboardRow1: ['q','w','e','r','t','y','u','i','o','p'],
    keyboardRow2: ['a','s','d','f','g','h','j','k','l'],
    keyboardRow3: ['z','x','c','v','b','n','m'],
    keyboardLanguage: 'EN',
    keyboardRowsEn: [
      ['q','w','e','r','t','y','u','i','o','p'],
      ['a','s','d','f','g','h','j','k','l'],
      ['z','x','c','v','b','n','m']
    ],
    keyboardRowsRu: [
      ['й','ц','у','к','е','н','г','ш','щ','з'],
      ['ф','ы','в','а','п','р','о','л','д'],
      ['я','ч','с','м','и','т','ь','б','ю']
    ]
  },
  onInit() {
    this.unsubscribeLink = link.subscribe((event) => {
      if (event.message && event.message.type === 'video.select') {
        const payload = event.message.payload || {}
        this.videoTitle = payload.title || 'Видео выбрано'
        this.videoSubtitle = payload.channelTitle || 'Отправлено с телефона'
        this.playbackHint = 'Видео выбрано. Видеоплеер ещё не подключён.'
      }
      if (event.message && event.message.type === 'video.results') {
        const payload = event.message.payload || {}
        this.videoResults = Array.isArray(payload.items) ? payload.items : []
        this.searchHint = this.videoResults.length
          ? 'Найдено: ' + this.videoResults.length
          : 'Ничего не найдено'
      }
      if (event.message && event.message.type === 'video.search.error') {
        const payload = event.message.payload || {}
        this.searchHint = payload.message || 'Не удалось выполнить поиск'
      }
      if (event.state) {
        this.connected = event.state === 'connected'
        this.connectionLabel = this.connected ? 'Телефон подключён' : 'Нет соединения'
      }
    })
    link.checkConnection()
  },
  onDestroy() {
    if (this.unsubscribeLink) this.unsubscribeLink()
  },
  retryConnection() {
    link.checkConnection()
  },
  switchKeyboard() {
    if (this.keyboardLanguage === 'EN') {
      this.keyboardLanguage = 'RU'
      this.keyboardRow1 = this.keyboardRowsRu[0]
      this.keyboardRow2 = this.keyboardRowsRu[1]
      this.keyboardRow3 = this.keyboardRowsRu[2]
    } else {
      this.keyboardLanguage = 'EN'
      this.keyboardRow1 = this.keyboardRowsEn[0]
      this.keyboardRow2 = this.keyboardRowsEn[1]
      this.keyboardRow3 = this.keyboardRowsEn[2]
    }
  },
  appendSearch(value) {
    if (this.searchQuery.length < 80) this.searchQuery += value
  },
  deleteSearch() {
    this.searchQuery = this.searchQuery.slice(0, -1)
  },
  clearSearch() {
    this.searchQuery = ''
    this.videoResults = []
  },
  searchOnPhone() {
    const query = (this.searchQuery || '').trim()
    if (!query) {
      this.searchHint = 'Введи поисковый запрос'
      return
    }
    if (!link.send('video.search', { query })) {
      this.searchHint = 'Нет соединения'
      return
    }
    this.searchHint = 'Ищем на телефоне…'
    this.videoResults = []
  },
  selectVideo(videoId, title, channelTitle) {
    const payload = { videoId, title, channelTitle }
    if (!link.send('video.select', payload)) {
      this.searchHint = 'Нет соединения'
      return
    }
    this.videoTitle = title || 'Видео выбрано'
    this.videoSubtitle = channelTitle || 'Выбрано на часах'
    this.searchHint = 'Видео отправлено в приложение телефона'
  },
  sendPlay() {
    if (!link.send('playback.command', { action: 'play' })) {
      this.connectionLabel = 'Нет соединения'
    } else {
      this.playbackHint = 'Команда отправлена. Видеоплеер ещё не подключён.'
    }
  },
  sendPause() {
    if (!link.send('playback.command', { action: 'pause' })) {
      this.connectionLabel = 'Нет соединения'
    } else {
      this.playbackHint = 'Команда отправлена. Видеоплеер ещё не подключён.'
    }
  },
  sendStop() {
    if (!link.send('playback.command', { action: 'stop' })) {
      this.connectionLabel = 'Нет соединения'
    } else {
      this.playbackHint = 'Команда отправлена. Видеоплеер ещё не подключён.'
    }
  }
}
</script>