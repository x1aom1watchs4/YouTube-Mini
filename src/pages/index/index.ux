<template>
  <div class="page">
    <div class="header">
      <text class="logo">SHORTS</text>
      <text class="status">{{connected ? 'ONLINE' : 'OFFLINE'}}</text>
    </div>
    <text class="hint">SEARCH ON PHONE</text>
    <text class="subhint">Results appear here automatically</text>
    <list class="results" bounces="true">
      <list-item for="{{videoList}}" tid="videoId" class="result" type="video" @click="selectResult($item)">
        <text class="result-title">{{$item.title}}</text>
        <text class="result-channel">{{$item.channelTitle}}</text>
      </list-item>
    </list>
    <text if="{{videoList.length === 0}}" class="empty">NO RESULTS YET</text>
    <div class="selected">
      <text class="selected-label">SELECTED</text>
      <text class="selected-title">{{videoTitle}}</text>
    </div>
    <div class="actions">
      <text class="action primary" @click="openVideoOnPhone">OPEN ON PHONE</text>
      <text class="action" @click="retryConnection">RETRY</text>
    </div>
  </div>
</template>
<style>
.page { width: 100%; height: 100%; padding: 10px; background-color: #080808; flex-direction: column; }
.header { height: 28px; flex-direction: row; justify-content: space-between; align-items: center; }
.logo { color: #ffffff; font-size: 19px; font-weight: bold; }
.status { color: #ff3655; font-size: 11px; font-weight: bold; }
.hint { color: #ffffff; font-size: 14px; font-weight: bold; margin-top: 5px; }
.subhint { color: #999999; font-size: 10px; margin-top: 2px; }
.results { width: 100%; flex: 1; margin-top: 7px; }
.result { width: 100%; height: 47px; padding-left: 8px; padding-right: 8px; justify-content: center; flex-direction: column; border-bottom-width: 1px; border-bottom-color: #292929; }
.result-title { color: #ffffff; font-size: 12px; }
.result-channel { color: #999999; font-size: 9px; margin-top: 2px; }
.empty { color: #777777; font-size: 11px; text-align: center; margin-top: 8px; }
.selected { height: 38px; padding-left: 7px; justify-content: center; flex-direction: column; background-color: #191919; border-radius: 7px; }
.selected-label { color: #ff3655; font-size: 8px; font-weight: bold; }
.selected-title { color: #ffffff; font-size: 10px; margin-top: 2px; }
.actions { height: 39px; flex-direction: row; margin-top: 6px; }
.action { flex: 1; height: 36px; margin-left: 3px; margin-right: 3px; border-radius: 8px; background-color: #292929; color: #ffffff; text-align: center; font-size: 11px; padding-top: 11px; font-weight: bold; }
.primary { background-color: #e9003d; }
</style>
<script>
import link from '../../common/scripts/interconnect'
export default {
  private: {
    connected: false,
    videoList: [],
    videoTitle: 'Nothing selected',
    selectedVideoId: '',
    selectedThumbnailUrl: ''
  },
  onInit() {
    this.unsubscribeLink = link.subscribe((event) => {
      if (event.message && event.message.type === 'video.results') {
        const payload = event.message.payload || {}
        this.videoList = Array.isArray(payload.items) ? payload.items : []
      }
      if (event.message && event.message.type === 'video.search.error') {
        this.videoList = []
      }
      if (event.state) this.connected = event.state === 'connected'
    })
    link.checkConnection()
  },
  onDestroy() {
    if (this.unsubscribeLink) this.unsubscribeLink()
  },
  retryConnection() { link.checkConnection() },
  selectResult(item) {
    if (!item || !item.videoId) return
    this.selectedVideoId = item.videoId
    this.videoTitle = item.title || 'Short selected'
    this.selectedThumbnailUrl = item.thumbnailUrl || ''
    link.send('video.select', {
      videoId: item.videoId,
      title: this.videoTitle,
      channelTitle: item.channelTitle || '',
      thumbnailUrl: this.selectedThumbnailUrl
    })
  },
  openVideoOnPhone() {
    if (!this.selectedVideoId) return
    link.send('video.open', { videoId: this.selectedVideoId })
  }
}
</script>
