<script>
import link from '../../common/scripts/interconnect'

export default {
  private: {
    connected: false,
    connectionLabel: 'Нет соединения',
    videoTitle: 'Пока ничего не выбрано',
    videoSubtitle: 'Откройте YouTube Mini на телефоне',
    selectedVideoId: '',
    selectedThumbnailUrl: '',
    commentsText: 'Комментарии ещё не загружены',
    selectedLikeCount: '—',
    selectedCommentCount: '—',
    searchHint: 'Поиск выполняется на телефоне',
  },
  onInit() {
    this.unsubscribeLink = link.subscribe((event) => {
      if (event.message && event.message.type === 'video.select') {
        const payload = event.message.payload || {}
        this.videoTitle = payload.title || 'Видео выбрано'
        this.videoSubtitle = payload.channelTitle || 'Отправлено с телефона'
        this.selectedVideoId = payload.videoId || ''
        this.selectedThumbnailUrl = payload.thumbnailUrl || ''
      }
      if (event.message && event.message.type === 'comments.items') {
        const payload = event.message.payload || {}
        const items = Array.isArray(payload.items) ? payload.items : []
        this.commentsText = items.length
          ? items.map((item, index) => (index + 1) + '. ' + item.author + ': ' + item.text).join('\n\n')
          : 'Публичных комментариев нет или они отключены'
      }
      if (event.message && event.message.type === 'video.search.error') {
        const payload = event.message.payload || {}
        this.searchHint = payload.message || 'Не удалось выполнить поиск'
      }
      if (event.state) {
        this.connected = event.state === 'connected'
        this.connectionLabel = this.connected ? 'Телефон подключён' : 'Нет соединения'
      }
    })
    link.checkConnection()
  },
  onDestroy() {
    if (this.unsubscribeLink) this.unsubscribeLink()
  },
  retryConnection() {
    link.checkConnection()
  },
  selectVideo(videoId, title, channelTitle, thumbnailUrl, likeCount, commentCount) {
    const payload = { videoId, title, channelTitle, thumbnailUrl }
    if (!link.send('video.select', payload)) {
      this.searchHint = 'Нет соединения'
      return
    }
    this.videoTitle = title || 'Видео выбрано'
    this.videoSubtitle = channelTitle || 'Выбрано на часах'
    this.selectedVideoId = videoId || ''
    this.selectedThumbnailUrl = thumbnailUrl || ''
    this.selectedLikeCount = likeCount || '—'
    this.selectedCommentCount = commentCount || '—'
    this.searchHint = 'Видео отправлено в приложение телефона'
  },
  thumbnailError() {
    this.searchHint = 'Обложка не загрузилась. Проверь подключение часов к интернету.'
  },
  loadComments() {
    if (!this.selectedVideoId) {
      this.commentsText = 'Сначала выбери видео'
      return
    }
    if (!link.send('comments.load', { videoId: this.selectedVideoId })) {
      this.commentsText = 'Нет соединения с телефоном'
    } else {
      this.commentsText = 'Загружаем публичные комментарии…'
    }
  },
  openVideoOnPhone() {
    if (!this.selectedVideoId) {
      this.searchHint = 'Сначала выбери видео'
      return
    }
    if (!link.send('video.open', { videoId: this.selectedVideoId })) {
      this.searchHint = 'Нет соединения с телефоном'
    } else {
      this.searchHint = 'Видео открывается на телефоне'
    }
  },
}
</script>