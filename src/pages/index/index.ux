<script>
import link from '../../common/scripts/interconnect'
import audio from '@system.audio'
import file from '@system.file'

export default {
  private: {
    connected: false,
    connectionLabel: 'Not connected',
    videoTitle: 'No video selected',
    videoSubtitle: 'Open YouTube Mini on your phone',
    selectedVideoId: '',
    selectedThumbnailUrl: '',
    thumbnailFailed: true,
    thumbnailMessage: 'Choose a video on your phone to load its cover.',
    audioSource: '',
    audioStatus: 'Waiting for an audio link from your phone.',
    commentsText: 'Tap VIEW COMMENTS to load comments.',
    commentImages: [],
    incomingCommentImages: {},
    pendingAudioId: '',
    pendingAudioName: 'audio.mp3',
    pendingAudioTotal: 0,
    pendingAudioReceived: 0,
    pendingAudioWritten: 0,
    pendingAudioChunkIndex: -1,
    pendingAudioWriting: false,
    pendingAudioFinished: false,
    pendingAudioUri: 'internal://files/current_audio.mp3',
    selectedLikeCount: '—',
    selectedCommentCount: '—',
    searchHint: 'Enter a title, then search using your phone.',
    searchQuery: '',
    videoResults: [],
  },
  onInit() {
    audio.autoplay = false
    audio.loop = false
    audio.onplay = () => { this.audioStatus = 'PLAYING' }
    audio.onpause = () => { this.audioStatus = 'PAUSED' }
    audio.onstop = () => { this.audioStatus = 'STOPPED' }
    audio.onloadeddata = () => { this.audioStatus = 'READY TO PLAY' }
    audio.onended = () => { this.audioStatus = 'PLAYBACK FINISHED' }
    audio.onerror = () => { this.audioStatus = 'PLAYBACK ERROR. CHECK THE AUDIO URL.' }
    this.unsubscribeLink = link.subscribe((event) => {
      if (event.message && event.message.type === 'video.select') {
        const payload = event.message.payload || {}
        this.videoTitle = payload.title || 'Video selected'
        this.videoSubtitle = payload.channelTitle || 'Sent from phone'
        this.selectedVideoId = payload.videoId || ''
        this.selectedThumbnailUrl = payload.thumbnailUrl || ''
        this.thumbnailFailed = !this.selectedThumbnailUrl
        this.thumbnailMessage = this.selectedThumbnailUrl ? 'Loading cover...' : 'No cover URL was sent.'
        this.selectedLikeCount = payload.likeCount || '—'
        this.selectedCommentCount = payload.commentCount || '—'
      }
      if (event.message && event.message.type === 'audio.source') {
        const payload = event.message.payload || {}
        const source = payload.src || ''
        if (source.indexOf('https://') !== 0 && source.indexOf('http://') !== 0) {
          this.audioStatus = 'Invalid audio URL. Send a direct HTTP(S) audio link.'
        } else {
          try {
            audio.pause()
            audio.src = source
            audio.meta = { title: payload.title || 'YouTube Mini audio', artist: 'YouTube Mini', album: 'Audio' }
            audio.autoplay = false
            this.audioSource = source
            this.audioStatus = 'AUDIO READY. PRESS PLAY.'
          } catch (error) {
            this.audioStatus = 'Could not load audio source.'
          }
        }
      }

      if (event.message && event.message.type === 'audio.file.start') {
        const payload = event.message.payload || {}
        this.pendingAudioId = payload.id || ''
        this.pendingAudioName = payload.name || 'audio.mp3'
        this.pendingAudioTotal = Number(payload.total) || 0
        this.pendingAudioReceived = 0
        this.pendingAudioWritten = 0
        this.pendingAudioChunkIndex = -1
        this.pendingAudioWriting = false
        this.pendingAudioFinished = false
        this.audioStatus = 'RECEIVING AUDIO FILE...'
      }
      if (event.message && event.message.type === 'audio.file.chunk') {
        const payload = event.message.payload || {}
        if (payload.id === this.pendingAudioId) {
          const chunk = this.decodeBase64(payload.data || '')
          const chunkIndex = Number(payload.index)
          if (chunk && chunk.length && !this.pendingAudioWriting && chunkIndex === this.pendingAudioWritten) {
            this.pendingAudioChunkIndex = chunkIndex
            this.pendingAudioWriting = true
            file.writeArrayBuffer({
              uri: this.pendingAudioUri,
              buffer: chunk.buffer,
              append: chunkIndex > 0,
              success: () => {
                this.pendingAudioWriting = false
                this.pendingAudioWritten += 1
                this.pendingAudioReceived += 1
                link.send('audio.file.ack', { id: this.pendingAudioId, index: chunkIndex })
                this.finishAudioFileIfReady()
              },
              fail: () => {
                this.pendingAudioWriting = false
                this.audioStatus = 'AUDIO FILE SAVE FAILED. TRANSFER STOPPED.'
                link.send('audio.file.error', { id: this.pendingAudioId, message: 'File save failed.' })
              }
            })
          }
        }
      }
      if (event.message && event.message.type === 'audio.file.finish') {
        const payload = event.message.payload || {}
        if (payload.id === this.pendingAudioId) {
          this.pendingAudioFinished = true
          this.finishAudioFileIfReady()
        }
      }
      if (event.message && event.message.type === 'comments.image') {
        const payload = event.message.payload || {}
        const bytes = this.decodeBase64(payload.base64 || '')
        if (bytes && payload.id) {
          const uri = 'internal://files/comments/' + payload.id + '.png'
          file.writeArrayBuffer({ uri, buffer: bytes.buffer, success: () => {
            this.commentImages.push({ uri })
            this.commentsText = 'Comments are shown as images.'
          }, fail: () => { this.commentsText = 'Could not save comment image.' } })
        }
      }
      if (event.message && event.message.type === 'comments.items') {
        const payload = event.message.payload || {}
        const items = Array.isArray(payload.items) ? payload.items : []
        this.commentsText = payload.error || (items.length
          ? items.map((item, index) => (index + 1) + '. ' + item.author + ': ' + item.text).join('\n\n')
          : 'No public comments found. Comments may be disabled.')
      }
      if (event.message && event.message.type === 'video.results') {
        const payload = event.message.payload || {}
        this.videoResults = Array.isArray(payload.items) ? payload.items : []
        this.searchHint = this.videoResults.length ? 'Tap a result to select it.' : 'No videos found.'
      }
      if (event.message && event.message.type === 'video.search.error') {
        const payload = event.message.payload || {}
        this.searchHint = payload.message || 'Search failed'
      }
      if (event.state) {
        this.connected = event.state === 'connected'
        this.connectionLabel = this.connected ? 'Phone connected' : 'Not connected'
      }
    })
    link.checkConnection()
  },
  onDestroy() {
    if (this.unsubscribeLink) this.unsubscribeLink()
    audio.onplay = null
    audio.onpause = null
    audio.onstop = null
    audio.onloadeddata = null
    audio.onended = null
    audio.onerror = null
  },
  retryConnection() {
    link.checkConnection()
  },
  appendSearchKey(value) {
    if (this.searchQuery.length < 60) this.searchQuery += value
  },
  keyA() { this.appendSearchKey('a') },
  keyB() { this.appendSearchKey('b') },
  keyC() { this.appendSearchKey('c') },
  keyD() { this.appendSearchKey('d') },
  keyE() { this.appendSearchKey('e') },
  keyF() { this.appendSearchKey('f') },
  keyG() { this.appendSearchKey('g') },
  keyH() { this.appendSearchKey('h') },
  keyI() { this.appendSearchKey('i') },
  keyJ() { this.appendSearchKey('j') },
  keyK() { this.appendSearchKey('k') },
  keyL() { this.appendSearchKey('l') },
  keyM() { this.appendSearchKey('m') },
  keyN() { this.appendSearchKey('n') },
  keyO() { this.appendSearchKey('o') },
  keyP() { this.appendSearchKey('p') },
  keyQ() { this.appendSearchKey('q') },
  keyR() { this.appendSearchKey('r') },
  keyS() { this.appendSearchKey('s') },
  keyT() { this.appendSearchKey('t') },
  keyU() { this.appendSearchKey('u') },
  keyV() { this.appendSearchKey('v') },
  keyW() { this.appendSearchKey('w') },
  keyX() { this.appendSearchKey('x') },
  keyY() { this.appendSearchKey('y') },
  keyZ() { this.appendSearchKey('z') },
  searchSpace() { this.appendSearchKey(' ') },
  searchBackspace() { this.searchQuery = this.searchQuery.slice(0, -1) },
  searchClear() { this.searchQuery = ''; this.videoResults = [] },
  searchFromWatch() {
    const query = this.searchQuery.trim()
    if (!query) {
      this.searchHint = 'Type something to search.'
      return
    }
    if (!link.send('video.search', { query })) {
      this.searchHint = 'Phone is not connected.'
      return
    }
    this.searchHint = 'Searching on phone...'
    this.videoResults = []
  },
  selectSearchResult(item) {
    if (!item) return
    this.videoTitle = item.title || 'Selected video'
    this.videoSubtitle = item.channelTitle || ''
    this.selectedVideoId = item.videoId || ''
    this.selectedThumbnailUrl = item.thumbnailUrl || ''
    this.thumbnailFailed = !this.selectedThumbnailUrl
    this.thumbnailMessage = this.selectedThumbnailUrl ? 'Loading cover...' : 'No cover URL.'
    this.selectedLikeCount = item.likeCount || '—'
    this.selectedCommentCount = item.commentCount || '—'
    if (!link.send('video.select', item)) this.searchHint = 'Phone is not connected.'
    else this.searchHint = 'Video selected.'
  },
  selectVideo(videoId, title, channelTitle, thumbnailUrl, likeCount, commentCount) {
    const payload = { videoId, title, channelTitle, thumbnailUrl }
    if (!link.send('video.select', payload)) {
      this.searchHint = 'Not connected'
      return
    }
    this.videoTitle = title || 'Video selected'
    this.videoSubtitle = channelTitle || 'Selected on watch'
    this.selectedVideoId = videoId || ''
    this.selectedThumbnailUrl = thumbnailUrl || ''
    this.thumbnailFailed = !this.selectedThumbnailUrl
    this.thumbnailMessage = this.selectedThumbnailUrl ? 'Loading cover...' : 'No cover URL was provided.'
    this.selectedLikeCount = likeCount || '—'
    this.selectedCommentCount = commentCount || '—'
    this.searchHint = 'Video sent to phone app.'
  },
  thumbnailLoaded() {
    this.thumbnailFailed = false
    this.thumbnailMessage = 'Cover loaded.'
  },
  thumbnailError() {
    this.thumbnailFailed = true
    this.thumbnailMessage = 'Cover could not load. Check watch internet access.'
    this.searchHint = 'The video cover could not be downloaded.'
  },

  finishAudioFileIfReady() {
    if (!this.pendingAudioFinished || this.pendingAudioWriting ||
        this.pendingAudioWritten !== this.pendingAudioTotal || this.pendingAudioTotal <= 0) return
    try {
      audio.pause()
      audio.src = this.pendingAudioUri
      audio.meta = { title: this.pendingAudioName, artist: 'Local file', album: 'YouTube Mini' }
      audio.autoplay = false
      this.audioSource = this.pendingAudioUri
      this.audioStatus = 'FILE READY. PRESS PLAY.'
      link.send('audio.file.complete', { id: this.pendingAudioId })
    } catch (error) {
      this.audioStatus = 'COULD NOT OPEN LOCAL AUDIO FILE.'
      link.send('audio.file.error', { id: this.pendingAudioId, message: 'Audio source could not be opened.' })
    }
  },
  playAudio() {
    if (!this.audioSource) {
      this.audioStatus = 'Send a direct audio URL from the phone app first.'
      return
    }
    try {
      audio.play()
      this.audioStatus = 'STARTING AUDIO...'
    } catch (error) {
      this.audioStatus = 'PLAY FAILED. CHECK THE AUDIO URL.'
    }
  },
  pauseAudio() {
    if (!this.audioSource) {
      this.audioStatus = 'No audio source received yet.'
      return
    }
    try { audio.pause() } catch (error) { this.audioStatus = 'PAUSE FAILED.' }
  },
  stopAudio() {
    if (!this.audioSource) {
      this.audioStatus = 'No audio source received yet.'
      return
    }
    try { audio.stop() } catch (error) { this.audioStatus = 'STOP FAILED.' }
  },
  decodeBase64(value) {
    const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
    const clean = value.replace(/[^A-Za-z0-9+/=]/g, '')
    const out = []
    let buffer = 0
    let bits = 0
    for (let i = 0; i < clean.length; i++) {
      if (clean[i] === '=') break
      const n = alphabet.indexOf(clean[i])
      if (n < 0) continue
      buffer = (buffer << 6) | n
      bits += 6
      if (bits >= 8) {
        bits -= 8
        out.push((buffer >> bits) & 255)
      }
    }
    return new Uint8Array(out)
  },
  loadComments() {
    if (!this.selectedVideoId) {
      this.commentsText = 'Select a video first.'
      return
    }
    if (!link.send('comments.load', { videoId: this.selectedVideoId })) {
      this.commentsText = 'Phone is not connected.'
    } else {
      this.commentsText = 'Loading public comments...'
    }
  },
  openVideoOnPhone() {
    if (!this.selectedVideoId) {
      this.searchHint = 'Select a video first.'
      return
    }
    if (!link.send('video.open', { videoId: this.selectedVideoId })) {
      this.searchHint = 'Phone is not connected.'
    } else {
      this.searchHint = 'Opening video on phone...'
    }
  },
}
</script>