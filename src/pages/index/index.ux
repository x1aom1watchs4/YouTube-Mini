<template>
  <scroll class="page" scroll-y="true">
    <div class="top">
      <text class="brand">YouTube Mini</text>
      <text class="version">0.1 • WATCH</text>
    </div>

    <div class="connection">
      <div class="status-dot {{connected ? 'online' : 'offline'}}"></div>
      <text class="status">{{connectionLabel}}</text>
    </div>

    <div class="search-panel">
      <text class="video-label">SEARCH YOUTUBE</text>
      <text class="query-display">{{searchQuery || 'Type a video name...'}}</text>
      <div class="keyboard-row">
        <text class="key" @click="keyA">A</text><text class="key" @click="keyB">B</text><text class="key" @click="keyC">C</text><text class="key" @click="keyD">D</text><text class="key" @click="keyE">E</text><text class="key" @click="keyF">F</text><text class="key" @click="keyG">G</text><text class="key" @click="keyH">H</text><text class="key" @click="keyI">I</text>
      </div>
      <div class="keyboard-row">
        <text class="key" @click="keyJ">J</text><text class="key" @click="keyK">K</text><text class="key" @click="keyL">L</text><text class="key" @click="keyM">M</text><text class="key" @click="keyN">N</text><text class="key" @click="keyO">O</text><text class="key" @click="keyP">P</text><text class="key" @click="keyQ">Q</text><text class="key" @click="keyR">R</text>
      </div>
      <div class="keyboard-row">
        <text class="key" @click="keyS">S</text><text class="key" @click="keyT">T</text><text class="key" @click="keyU">U</text><text class="key" @click="keyV">V</text><text class="key" @click="keyW">W</text><text class="key" @click="keyX">X</text><text class="key" @click="keyY">Y</text><text class="key" @click="keyZ">Z</text>
      </div>
      <div class="keyboard-row">
        <text class="key key-wide" @click="searchSpace">SPACE</text>
        <text class="key key-action" @click="searchBackspace">DEL</text>
        <text class="key key-action" @click="searchClear">CLEAR</text>
      </div>
      <text class="search-button" @click="searchFromWatch">SEARCH ON PHONE</text>
      <text class="search-hint">{{searchHint}}</text>
    </div>
    <div class="watch-results">
      <text class="video-label">SEARCH RESULTS</text>
      <div class="result" for="{{videoResults}}" @click="selectSearchResult($item)">
        <image class="result-thumb" src="{{$item.thumbnailUrl}}" />
        <text class="result-title">{{$item.title}}</text>
        <text class="result-channel">{{$item.channelTitle}}</text>
        <text class="result-channel">LIKES: {{$item.likeCount}}  COMMENTS: {{$item.commentCount}}</text>
      </div>
      <text if="{{videoResults.length === 0}}" class="search-hint">Results from your phone will appear here.</text>
    </div>

    <div class="hero">
      <text class="eyebrow">YOUTUBE ON YOUR WRIST</text>
      <text class="headline">Your video</text>
      <text class="sub">Select a video in the phone app.</text>
    </div>

    <div class="video-card">
      <text class="video-label">SELECTED VIDEO</text>
      <image if="{{selectedThumbnailUrl && !thumbnailFailed}}" class="selected-thumb" src="{{selectedThumbnailUrl}}" @complete="thumbnailLoaded" @error="thumbnailError" />
      <div if="{{!selectedThumbnailUrl || thumbnailFailed}}" class="thumb-fallback">
        <text class="thumb-fallback-title">VIDEO COVER</text>
        <text class="thumb-fallback-note">{{thumbnailMessage}}</text>
      </div>
      <text class="video-title">{{videoTitle}}</text>
      <text class="video-sub">{{videoSubtitle}}</text>
      <text class="search-hint">{{searchHint}}</text>
      <text class="open-video" @click="openVideoOnPhone">OPEN ON PHONE</text>
      <div class="stats-panel">
        <div class="stat"><text class="stat-value">{{selectedLikeCount}}</text><text class="stat-label">LIKES</text></div>
        <div class="stat"><text class="stat-value">{{selectedCommentCount}}</text><text class="stat-label">COMMENTS</text></div>
      </div>
      <text class="comments-button" @click="loadComments">VIEW COMMENTS</text>
      <text class="comments-heading">PUBLIC COMMENTS</text>
      <text class="comments-text">{{commentsText}}</text>
      <div class="comment-image-card" for="{{commentImages}}">
        <image class="comment-image" src="{{$item.uri}}" />
      </div>
    </div>

    <div class="audio-card">
      <text class="video-label">AUDIO PLAYER</text>
      <text class="audio-status">{{audioStatus}}</text>
      <div class="audio-controls">
        <text class="audio-control audio-play" @click="playAudio">PLAY</text>
        <text class="audio-control" @click="pauseAudio">PAUSE</text>
        <text class="audio-control" @click="stopAudio">STOP</text>
      </div>
      <text class="audio-note">Choose an audio file in the phone app and send it here. Direct audio URLs are also supported.</text>
    </div>

    <div class="bottom">
      <text class="retry" @click="retryConnection">CHECK CONNECTION</text>
      <text class="foot">PHONE - WATCH</text>
    </div>
  </scroll>
</template>

