<template>
  <div class="page">
    <div class="topbar"><text class="logo">SHORTS</text><text class="connection">{{connected ? '●' : '○'}}</text></div>
    <div class="viewer" @swipe="handleSwipe">
      <image if="{{currentFrameSource}}" class="poster" src="{{currentFrameSource}}" />
      <image if="{{!currentFrameSource && currentThumbnail}}" class="poster" src="{{currentThumbnail}}" />
      <div if="{{!currentThumbnail && !currentFrameSource}}" class="poster-empty">
        <text class="empty-icon">▶</text><text class="empty-title">NO SHORT SELECTED</text><text class="empty-sub">Search on your phone</text>
      </div>
            <div class="shade"></div>
      <div class="video-info">
        <text class="channel">{{currentChannel}}</text>
        <text class="video-title">{{currentTitle}}</text>
        <text class="playback-note">{{streamActive ? 'LIVE VIDEO • PHONE DECODE' : 'SHORTS PREVIEW'}}</text>
      </div>
      <div class="actions">
        <div class="action" @click="showComments"><text class="action-icon">▤</text><text class="action-count">{{currentCommentCount}}</text></div>
        <div class="action"><text class="action-icon">♥</text><text class="action-count">{{currentLikeCount}}</text></div>
        <div class="action" @click="openVideoOnPhone"><text class="action-icon">↗</text><text class="action-label">OPEN</text></div>
      </div>
      <div class="bottom-controls">
        <text class="nav-button" @click="previousVideo">‹ PREV</text><text class="nav-button" @click="togglePlayback">{{playing ? 'Ⅱ PAUSE' : '▶ PLAY'}}</text><text class="nav-button" @click="nextVideo">NEXT ›</text>
      </div>
    </div>
    <div if="{{commentsVisible}}" class="comments-panel">
      <div class="comments-top"><text class="comments-title">COMMENTS ({{commentList.length}})</text><text class="close" @click="hideComments">CLOSE ×</text></div>
      <list class="comments-list" bounces="true">
        <list-item for="{{commentList}}" tid="index" class="comment"><text class="author">{{$item.author}}</text><text class="comment-text">{{$item.text}}</text></list-item>
      </list>
      <text if="{{commentList.length === 0}}" class="comments-empty">{{commentsLabel}}</text>
    </div>
  </div>
</template>
<style>
.page { width: 100%; height: 100%; background-color: #050505; flex-direction: column; }
.topbar { height: 27px; padding-left: 12px; padding-right: 12px; flex-direction: row; justify-content: space-between; align-items: center; background-color: #080808; }
.logo { color: #ffffff; font-size: 15px; font-weight: bold; }
.connection { color: #ff3154; font-size: 12px; }
.viewer { width: 100%; flex: 1; position: relative; background-color: #151515; }
.poster { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; object-fit: cover; }
.poster-empty { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; justify-content: center; align-items: center; background-color: #171717; }
.empty-icon { color: #ff3154; font-size: 34px; }
.empty-title { color: #ffffff; font-size: 11px; font-weight: bold; margin-top: 9px; }
.empty-sub { color: #aaaaaa; font-size: 9px; margin-top: 4px; }
.shade { position: absolute; left: 0px; bottom: 0px; width: 100%; height: 46%; background-image: linear-gradient(transparent, rgba(0,0,0,0.92)); }
.video-info { position: absolute; left: 12px; right: 48px; bottom: 42px; flex-direction: column; }
.channel { color: #ffffff; font-size: 10px; font-weight: bold; }
.video-title { color: #ffffff; font-size: 11px; margin-top: 4px; max-lines: 3; }
.playback-note { color: #ffb8c4; font-size: 7px; margin-top: 6px; }
.actions { position: absolute; right: 7px; bottom: 65px; width: 36px; flex-direction: column; align-items: center; }
.action { width: 36px; height: 48px; justify-content: center; align-items: center; }
.action-icon { color: #ffffff; font-size: 20px; font-weight: bold; }
.action-count { color: #ffffff; font-size: 8px; margin-top: 1px; }
.action-label { color: #ffffff; font-size: 7px; margin-top: 2px; }
.bottom-controls { position: absolute; left: 8px; right: 8px; bottom: 7px; height: 27px; flex-direction: row; align-items: center; justify-content: space-between; }
.nav-button { color: #ffffff; background-color: rgba(25,25,25,0.85); font-size: 9px; padding: 6px; border-radius: 12px; }
.position { color: #dddddd; font-size: 8px; }
.comments-panel { position: absolute; left: 0px; right: 0px; bottom: 0px; height: 84%; background-color: #111111; border-top-left-radius: 14px; border-top-right-radius: 14px; padding: 10px; }
.comments-top { height: 24px; flex-direction: row; justify-content: space-between; align-items: center; }
.comments-title { color: #ffffff; font-size: 12px; font-weight: bold; }
.close { color: #ff5574; font-size: 9px; }
.comments-list { width: 100%; flex: 1; margin-top: 5px; }
.comment { width: 100%; padding: 6px 2px; flex-direction: column; border-bottom-width: 1px; border-bottom-color: #292929; }
.author { color: #ff7890; font-size: 9px; }
.comment-text { color: #eeeeee; font-size: 10px; margin-top: 3px; }
.comments-empty { color: #aaaaaa; font-size: 10px; margin-top: 12px; }
</style>
<script>
import link from '../../common/scripts/interconnect'
import file from '@system.file'
export default {
  private: {
    connected: false, videoList: [], videoIndex: 0, currentThumbnail: '',
    currentTitle: 'Find Shorts on your phone', currentChannel: 'YOUTUBE MINI',
    currentLikeCount: '—', currentCommentCount: '—', videoPosition: '0 / 0',
    selectedVideoId: '', commentList: [], commentsLabel: 'Select a Short to load comments',
    commentsVisible: false, currentFrameSource: '', streamActive: false,
    playing: false, frameBufferIndex: 0
  },
  onInit() {
    this.unsubscribeLink = link.subscribe((event) => {
      if (event.message && event.message.type === 'video.stream.start') {
        const payload = event.message.payload || {}
        this.streamActive = true
        this.playing = true
        this.frameBufferIndex = 0
        this.currentFrameSource = ''
        if (payload.title) this.currentTitle = payload.title
      }
      if (event.message && event.message.type === 'video.stream.frame') {
        const payload = event.message.payload || {}
        if (payload.data) this.renderVideoFrame(payload.data)
      }
      if (event.message && event.message.type === 'video.stream.end') {
        this.streamActive = false
        this.playing = false
      }
      if (event.message && event.message.type === 'video.stream.error') {
        const payload = event.message.payload || {}
        this.streamActive = false
        this.playing = false
        this.currentTitle = payload.message || 'Video transfer failed'
      }
      if (event.message && event.message.type === 'video.results') {
        const payload = event.message.payload || {}
        this.videoList = Array.isArray(payload.items) ? payload.items : []
        this.videoIndex = 0
        this.showCurrentVideo()
      }
      if (event.message && event.message.type === 'video.search.error') {
        const payload = event.message.payload || {}
        this.currentTitle = payload.message || 'Search failed'
        this.currentThumbnail = ''
      }
      if (event.message && event.message.type === 'comments.items') {
        const payload = event.message.payload || {}
        this.commentList = Array.isArray(payload.items) ? payload.items : []
        this.commentsLabel = payload.error || (this.commentList.length + ' comments loaded')
      }
      if (event.state) this.connected = event.state === 'connected'
    })
    link.checkConnection()
  },
  onDestroy() { if (this.unsubscribeLink) this.unsubscribeLink() },
  renderVideoFrame(encoded) {
    const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
    const clean = String(encoded).replace(/[^A-Za-z0-9+/=]/g, '')
    const padding = clean.endsWith('==') ? 2 : (clean.endsWith('=') ? 1 : 0)
    const bytes = new Uint8Array(Math.max(0, Math.floor(clean.length * 3 / 4) - padding))
    let out = 0
    for (let i = 0; i + 3 < clean.length; i += 4) {
      const a = alphabet.indexOf(clean.charAt(i))
      const b = alphabet.indexOf(clean.charAt(i + 1))
      const c = clean.charAt(i + 2) === '=' ? 0 : alphabet.indexOf(clean.charAt(i + 2))
      const d = clean.charAt(i + 3) === '=' ? 0 : alphabet.indexOf(clean.charAt(i + 3))
      const value = (a << 18) | (b << 12) | (c << 6) | d
      if (out < bytes.length) bytes[out++] = (value >> 16) & 255
      if (out < bytes.length) bytes[out++] = (value >> 8) & 255
      if (out < bytes.length) bytes[out++] = value & 255
    }
    const uri = this.frameBufferIndex % 2 === 0
      ? 'internal://cache/ytm-video-frame-a.jpg'
      : 'internal://cache/ytm-video-frame-b.jpg'
    file.writeArrayBuffer({
      uri,
      buffer: bytes,
      success: () => {
        this.currentFrameSource = uri
        this.frameBufferIndex += 1
      },
      fail: (error, code) => {
        this.streamActive = false
        this.playing = false
        console.error('Video frame write failed', error, code)
      }
    })
  },
  togglePlayback() {
    if (!this.streamActive) return
    this.playing = !this.playing
    link.send('playback.command', { action: this.playing ? 'play' : 'pause' })
  },
  showCurrentVideo() {
    this.currentFrameSource = ''
    this.streamActive = false
    this.playing = false
    const item = this.videoList[this.videoIndex]
    if (!item) {
      this.currentThumbnail = ''; this.currentTitle = 'Search Shorts on your phone'
      this.currentChannel = 'YOUTUBE MINI'; this.currentLikeCount = '—'
      this.currentCommentCount = '—'; this.selectedVideoId = ''; this.videoPosition = '0 / 0'
      return
    }
    this.currentThumbnail = item.thumbnailUrl || ''
    this.currentTitle = item.title || 'Short'
    this.currentChannel = item.channelTitle || ''
    this.currentLikeCount = item.likeCount || '—'
    this.currentCommentCount = item.commentCount || '—'
    this.selectedVideoId = item.videoId || ''
    this.videoPosition = (this.videoIndex + 1) + ' / ' + this.videoList.length
    this.commentList = []; this.commentsLabel = 'Loading comments...'
    if (this.selectedVideoId) {
      link.send('video.select', { videoId: this.selectedVideoId, title: this.currentTitle, channelTitle: this.currentChannel, thumbnailUrl: this.currentThumbnail, likeCount: this.currentLikeCount, commentCount: this.currentCommentCount })
      link.send('comments.load', { videoId: this.selectedVideoId })
    }
  },
  previousVideo() { if (!this.videoList.length) return; this.videoIndex = (this.videoIndex - 1 + this.videoList.length) % this.videoList.length; this.showCurrentVideo() },
  nextVideo() { if (!this.videoList.length) return; this.videoIndex = (this.videoIndex + 1) % this.videoList.length; this.showCurrentVideo() },
  handleSwipe(event) {
    if (!event || this.commentsVisible) return
    if (event.direction === 'up' || event.direction === 'left') this.nextVideo()
    if (event.direction === 'down' || event.direction === 'right') this.previousVideo()
  },
  showComments() { if (this.selectedVideoId) this.commentsVisible = true },
  hideComments() { this.commentsVisible = false },
  openVideoOnPhone() { if (this.selectedVideoId) link.send('video.open', { videoId: this.selectedVideoId }) }
}
</script>
