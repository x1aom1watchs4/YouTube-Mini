<template>
  <div class="page">
    <div class="top">
      <text class="brand">SHORTS</text>
      <text class="anim-link" @click="toggleAnimationTest">{{showAnimationTest ? 'BACK' : 'ANIM TEST'}}</text>
      <text class="state">{{connected ? '●' : '○'}}</text>
    </div>
    <div if="{{!showAnimationTest}}" class="content">
      <text class="section">FEED</text>
      <list class="feed" bounces="true">
        <list-item for="{{videoList}}" tid="videoId" class="video" type="video" @click="selectResult($item)">
          <text class="video-title">{{$item.title}}</text>
          <text class="meta">{{$item.channelTitle}}</text>
          <text class="stats">♥ {{$item.likeCount}}   COMMENTS {{$item.commentCount}}</text>
        </list-item>
      </list>
      <text if="{{videoList.length === 0}}" class="empty">SEARCH ON PHONE</text>
      <div class="comments-head">
        <text class="section">COMMENTS</text>
        <text class="meta">{{commentsLabel}}</text>
      </div>
      <list class="comments" bounces="true">
        <list-item for="{{commentList}}" tid="index" class="comment" type="comment">
          <text class="author">{{$item.author}}</text>
          <text class="comment-text">{{$item.text}}</text>
        </list-item>
      </list>
      <text if="{{commentList.length === 0}}" class="empty-comment">Tap a video to load comments</text>
      <div class="bottom">
        <text class="selected">{{selectedTitle}}</text>
        <text class="open" @click="openVideoOnPhone">OPEN ON PHONE</text>
      </div>
    </div>
    <div if="{{showAnimationTest}}" class="anim-test">
      <text class="anim-title">FRAME ANIMATION TEST</text>
      <image-animator class="animator" id="shortsAnimator" images="{{animationFrames}}" duration="900ms" iteration="infinite" />
      <text class="anim-note">6 local PNG frames • no video or audio</text>
      <div class="anim-controls">
        <text class="anim-button" @click="startAnimation">START</text>
        <text class="anim-button" @click="pauseAnimation">PAUSE</text>
        <text class="anim-button" @click="resumeAnimation">RESUME</text>
      </div>
      <text class="anim-foot">This checks Vela frame animation on the watch</text>
    </div>
  </div>
</template>
<style>
.page { width: 100%; height: 100%; padding: 9px; background-color: #080808; flex-direction: column; }
.top { height: 25px; flex-direction: row; justify-content: space-between; align-items: center; }
.brand { color: #ffffff; font-size: 18px; font-weight: bold; }
.state { color: #ff3154; font-size: 15px; }
.anim-link { color: #ff6b82; font-size: 9px; font-weight: bold; }
.content { width: 100%; flex: 1; flex-direction: column; }
.section { color: #ff3154; font-size: 10px; font-weight: bold; margin-top: 3px; }
.feed { width: 100%; height: 42%; margin-top: 3px; }
.video { width: 100%; height: 48px; padding-left: 5px; padding-right: 5px; justify-content: center; flex-direction: column; border-bottom-width: 1px; border-bottom-color: #303030; }
.video-title { color: #ffffff; font-size: 11px; max-lines: 2; }
.meta { color: #aaaaaa; font-size: 9px; margin-top: 2px; }
.stats { color: #dddddd; font-size: 9px; margin-top: 2px; }
.empty { color: #888888; font-size: 10px; text-align: center; margin-top: 8px; }
.comments-head { flex-direction: row; justify-content: space-between; align-items: center; height: 18px; }
.comments { width: 100%; flex: 1; }
.comment { width: 100%; padding: 4px; flex-direction: column; border-bottom-width: 1px; border-bottom-color: #292929; }
.author { color: #ff6b82; font-size: 9px; }
.comment-text { color: #eeeeee; font-size: 10px; margin-top: 2px; }
.empty-comment { color: #777777; font-size: 9px; text-align: center; margin-top: 5px; }
.bottom { height: 35px; flex-direction: row; justify-content: space-between; align-items: center; }
.selected { color: #dddddd; font-size: 9px; max-lines: 1; flex: 1; }
.open { color: #ffffff; background-color: #e9003d; font-size: 9px; padding: 7px; border-radius: 6px; }
.anim-test { width: 100%; flex: 1; flex-direction: column; align-items: center; justify-content: center; }
.anim-title { color: #ffffff; font-size: 13px; font-weight: bold; margin-bottom: 8px; }
.animator { width: 180px; height: 180px; }
.anim-note { color: #aaaaaa; font-size: 9px; margin-top: 8px; }
.anim-controls { width: 100%; flex-direction: row; justify-content: space-around; margin-top: 14px; }
.anim-button { color: #ffffff; background-color: #e9003d; font-size: 10px; padding: 8px; border-radius: 6px; }
.anim-foot { color: #777777; font-size: 8px; margin-top: 12px; }
</style>
<script>
import link from '../../common/scripts/interconnect'
export default {
  private: {
    connected: false,
    videoList: [],
    commentList: [],
    selectedTitle: 'Select a Short',
    selectedVideoId: '',
    commentsLabel: 'Select video',
    showAnimationTest: false,
    animationFrames: [
      { src: '/common/anim/frame-01.png' },
      { src: '/common/anim/frame-02.png' },
      { src: '/common/anim/frame-03.png' },
      { src: '/common/anim/frame-04.png' },
      { src: '/common/anim/frame-05.png' },
      { src: '/common/anim/frame-06.png' }
    ]
  },
  onInit() {
    this.unsubscribeLink = link.subscribe((event) => {
      if (event.message && event.message.type === 'video.results') {
        const payload = event.message.payload || {}
        this.videoList = Array.isArray(payload.items) ? payload.items : []
      }
      if (event.message && event.message.type === 'video.search.error') {
        this.videoList = []
      }
      if (event.message && event.message.type === 'comments.items') {
        const payload = event.message.payload || {}
        this.commentList = Array.isArray(payload.items) ? payload.items : []
        this.commentsLabel = payload.error || (this.commentList.length + ' loaded')
      }
      if (event.state) this.connected = event.state === 'connected'
    })
    link.checkConnection()
  },
  onDestroy() {
    if (this.unsubscribeLink) this.unsubscribeLink()
  },
  toggleAnimationTest() {
    this.showAnimationTest = !this.showAnimationTest
  },
  startAnimation() {
    this.$element('shortsAnimator').start()
  },
  pauseAnimation() {
    this.$element('shortsAnimator').pause()
  },
  resumeAnimation() {
    this.$element('shortsAnimator').resume()
  },
  selectResult(item) {
    if (!item || !item.videoId) return
    this.selectedVideoId = item.videoId
    this.selectedTitle = item.title || 'Short selected'
    this.commentList = []
    this.commentsLabel = 'Loading...'
    link.send('video.select', {
      videoId: item.videoId,
      title: this.selectedTitle,
      channelTitle: item.channelTitle || '',
      thumbnailUrl: item.thumbnailUrl || '',
      likeCount: item.likeCount || '—',
      commentCount: item.commentCount || '—'
    })
    link.send('comments.load', { videoId: item.videoId })
  },
  openVideoOnPhone() {
    if (!this.selectedVideoId) return
    link.send('video.open', { videoId: this.selectedVideoId })
  }
}
</script>
